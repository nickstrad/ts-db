{
  "name": "tsdb-architecture-pages",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ts-db architecture diagrams site: N architectures from a dropdown, built on the c4-sdk npm package",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --base /ts-db/",
    "preview": "vite preview --base /ts-db/",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "c4-sdk": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  }
}

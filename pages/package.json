{
  "name": "tsdb-architecture-pages",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ts-db architecture diagrams site: N architectures from a dropdown, built on an interim c4-sdk copy",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --base /ts-db/",
    "preview": "vite preview --base /ts-db/",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test",
    "sync:check": "./vendor/c4-sdk/sync.sh --check",
    "check": "npm run typecheck && npm run test && npm run build && npm run sync:check && npm run test:browser"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  }
}
